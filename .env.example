# Copy to .env.local for local dev. Never commit real values.
# Deployed app values are managed in Vercel Project Settings → Environment Variables.

# Use mock implementations for external services (great for demos and offline dev)
USE_MOCKS=true

# Add provider-specific AI keys here only if the application itself calls an AI API.

# Database — Neon/Postgres (optional; add deployed values in Vercel)
DATABASE_URL=

# Factory dashboard (set these in Vercel for the deployed factory)
# Basic Auth for the dashboard; production returns 503 until both are set.
FACTORY_BASIC_AUTH_USERNAME=
FACTORY_BASIC_AUTH_PASSWORD=
# GitHub user or org that owns created repos
FACTORY_GITHUB_OWNER=
# Fine-grained PAT, all repos: Administration, Contents, Issues, Pull requests, Actions, Workflows, Variables, Secrets (read/write); Metadata (read)
FACTORY_GITHUB_TOKEN=
# Optional: token copied into each app as the COPILOT_ASSIGN_TOKEN secret for the feature queue (defaults to FACTORY_GITHUB_TOKEN)
FACTORY_COPILOT_ASSIGN_TOKEN=
# Optional: token with models:read for GitHub Models, used to write repo descriptions from app prompts (defaults to FACTORY_GITHUB_TOKEN)
FACTORY_MODELS_TOKEN=
# Vercel token used to create projects; team id is optional for personal accounts
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
